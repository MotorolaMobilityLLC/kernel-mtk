&i2c6 {
	status = "ok";
	tfa98xx_0: tfa98xx@34 {
		compatible = "tfa,tfa98xx";
		reg = <0x34>;
		reset-gpio = <&pio 170 0>;
		reset-polarity = <1>;
	};
	tfa98xx_1: tfa98xx@35 {
		compatible = "tfa,tfa98xx";
		reg = <0x35>;
		reset-gpio = <&pio 124 0>;
		reset-polarity = <1>;
	};
};

&spk{
	status = "disabled";
};

&sound {
	mediatek,speaker-codec {
		sound-dai = <&tfa98xx_0 &tfa98xx_1>;
	};
};
