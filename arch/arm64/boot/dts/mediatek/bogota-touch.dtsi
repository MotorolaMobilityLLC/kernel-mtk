/* TOUCH start */

&spi0 {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;
	mediatek,pad-select = <0>, <1>, <2>, <3>;

	omnivision@0 {
		compatible = "omnivision,tcm-spi";
		reg = <0>; //Same as CS ID
		status = "ok";
		spi-max-frequency = <6000000>;
		interrupt-parent = <&pio>;
		interrupts = <22 0x2008>;

		omnivision,irq-gpio = <&pio 22 0x00>;
		omnivision,irq-on-state = <0>;
		omnivision,reset-gpio = <&pio 3 0x00>;
		omnivision,reset-on-state = <0>;
		omnivision,reset-active-ms = <20>;
		omnivision,reset-delay-ms = <200>;
		omnivision,power-delay-ms = <200>;
		omnivision,spi-mode = <3>;
		omnivision,byte-delay-us = <0>;
		omnivision,block-delay-us = <0>;
		omnivision,ubl-max-freq = <3000000>;
		omnivision,ubl-byte-delay-us = <20>;
        };

	chipone_tddi@1 {
		compatible = "chipone-tddi";
		reg = <1>;
		spi-max-frequency = <9600000>;
		interrupt-parent = <&pio>;
		interrupts = <22 0x2008>;
		chipone,rst-gpio = <&pio 3 0x00>;
		chipone,irq-gpio = <&pio 22 0x00>;
		chipone,x-res = <4320>;
		chipone,y-res = <9600>;

		/* Charger detect*/
		chipone,touch-charger-detect-enable;
		chipone,touch-charger-detect-type = "notify"; /* notify, poll */
		chipone,touch-charger-detect-psy-name = "mtk-master-charger"; /* usb */
		chipone,touch-charger-detect-psp = "POWER_SUPPLY_PROP_ONLINE";
		chipone,touch-charger-detect-psp-poll-interval = <1000>;
		chipone,supported_gesture_type = <0x06>;
	};

	focaltech@3{
		compatible = "focaltech,fts";
                reg = <3>; //Same as CS ID
                status = "ok";
		spi-max-frequency = <6000000>;
                focaltech,reset-gpio = <&pio 3 0x0>;
                focaltech,irq-gpio = <&pio 22 0x2>;
                focaltech,max-touch-number = <10>;
                focaltech,display-coords = <0 0 1080 2400>;
                //focaltech,report_gesture_key = <59>;
                //focaltech,supported_gesture_type = <0x06>;
                focaltech,panel-supplier = "dijing_ft8725";
                focaltech,touch-charger-detect-psy-name = "battery";
                focaltech,touch-charger-detect-psp = "POWER_SUPPLY_PROP_STATUS";
	};

	ilitek@2 {
                compatible = "tchip,ilitek";
                reg = <2>; //Same as CS ID
                status = "ok";
                touch,reset-gpio = <&pio 3 0x0>;
                touch,irq-gpio = <&pio 22 0x0>;
                touch,psy-name = "battery";
                //ilitek,report_gesture_key;
                //ilitek,supported_gesture_type = <0x06>; //bit2-0: double:single:zero tap
        };

};

