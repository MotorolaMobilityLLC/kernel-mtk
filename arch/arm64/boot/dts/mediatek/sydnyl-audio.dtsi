&pio {
	sia81xx_gpio_L: sia81xx_gpio_L {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO170__FUNC_GPIO170>;
			slew-rate = <1>;
			bias-disable;
		};
	};
	sia81xx_gpio_R: sia81xx_gpio_R {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO124__FUNC_GPIO124>;
			slew-rate = <1>;
			bias-disable;
		};
	};
};

&odm {
	status = "okay";
	si_pa_L: si_pa_L{
		compatible = "si,sia81xx";
		si,si_pa_type = "sia8168";
		si,si_pa_reset = <&pio 170 0>;
		pinctrl-names = "si_pa_gpio";
		pinctrl-0 = <&sia81xx_gpio_L>;
		si,si_pa_disable_pin = <0>;
		channel_num = <0>;
		status = "okay";
	};
	si_pa_R: si_pa_R{
		compatible = "si,sia81xx";
		si,si_pa_type = "sia8168";
		si,si_pa_reset = <&pio 124 0>;
		pinctrl-names = "si_pa_gpio";
		pinctrl-0 = <&sia81xx_gpio_R>;
		si,si_pa_disable_pin = <0>;
		channel_num = <1>;
		status = "okay";
	};
};

&i2c6 {
	status = "ok";
	clock-frequency = <400000>;

	aw87xxx_pa@58 {/* RCV */
		compatible = "awinic,aw87xxx_pa";
		reg = <0x58>;
		reset-gpio = <&pio 170 0>;
		dev_index = < 0 >; /* First pa dev_index 0 */
		status = "okay";
	};
	aw87xxx_pa@5B { /* SPK */
		compatible = "awinic,aw87xxx_pa";
		reg = <0x5B>;
		reset-gpio = <&pio 124 0>;
		dev_index = < 1 >; /* Sec PA dev_index 1 */
		status = "okay";
	};

	sipa_i2c_L: sipa_i2c_L@28{ /* Rcv */
		compatible = "si,sia81xx-i2c";
		reg = <0x28>;
		si,sipa-dev = <&si_pa_L>;
	};
	sipa_i2c_R: sipa_i2c_R@29{ /* Spk */
		compatible = "si,sia81xx-i2c";
		reg = <0x29>;
		si,sipa-dev = <&si_pa_R>;
	};

	fsa4480: fsa4480@42 {
		compatible = "fsa,fsa4480-i2c";
		reg = <0x42>;
		status = "disabled";
	};
};

&sound {
	si,sia81xx-max-num = <2>;
        si,sia81xx-aux-devs = <&si_pa_L>,<&si_pa_R>;
	si,sia81xx-aux-devs-prefix = "SpkrLeft","SpkrRight";
};

&spk{
	status = "disabled";
};
