&i2c6 {
	status = "okay";
	aw883xx_smartpa_0: aw883xx@34 {
		compatible = "awinic,aw883xx_smartpa";
		#sound-dai-cells = <0>;
		reg = <0x34>;
		reset-gpio = <&pio 124 0>;
		irq-gpio = <&pio 10 0>;
		sync-load = <1>;
		sound-channel = <1>;
		re-min = <1000>;
		re-max = <40000>;
		status = "okay";
 	};
  	aw883xx_smartpa_1: aw883xx_smartpa@37 {
		compatible = "awinic,aw883xx_smartpa";
		#sound-dai-cells = <0>;
		reg = <0x37>;
		reset-gpio = <&pio 170 0>;
		irq-gpio = <&pio 34 0>;
		sync-load = <1>;
		sound-channel = <0>;
		re-min = <1000>;
		re-max = <40000>;
		status = "okay";
	};
};

&spk{
	status = "disabled";
};

&sound {
	smartpa-hac-flag = <0>;
	mediatek,speaker-codec {
		sound-dai = <&aw883xx_smartpa_0 &aw883xx_smartpa_1>;
	};
};

&accdet {
	headset-mode-setting = <0x500 0x500 1 0x1f0
				0x800 0x800 0x20 0x44
				0x4 0x1
				0x5 0x3 0x3 0x5 0xa>;
};

&mt6377codec {
	engpios = <&pio 191 0>;
	ingpios = <&pio 192 0>;
};
