#CONFIG_DRM_PANEL_TM_NT36528A_667_720_HDPLUS_DPHY_VDO_120HZ=m
#CONFIG_DRM_PANEL_BOE_FT8057M_667_720_HDPLUS_DPHY_120HZ=m
#CONFIG_DRM_PANEL_CSOT_TD4160_667_720_HDPLUS_DPHY_VDO_120HZ=m
#CONFIG_DRM_PANEL_BOE_FT8057M_667_720_1604_DPHY_120HZ=m
#CONFIG_DRM_PANEL_TM_NT36528_667_HDP_DPHY_VDO_120HZ=m
#CONFIG_DRM_PANEL_BOE_FT8057S_667_720_1604_DPHY_120HZ=m
#CONFIG_DRM_PANEL_TM_NT36528A_667_HDP_DPHY_VDO_120HZ=m
#CONFIG_DRM_PANEL_MOT_VDO_BOE_NT37713_1080_2352_DPHY_120HZ=m
#CONFIG_DRM_PANEL_MOT_VDO_BOE_IL97605A_1080_2352_DPHY_120HZ=m
#CONFIG_DRM_PANEL_MOT_VDO_TM_VTDR6126A_1080_2352_DPHY_120HZ=m
#CONFIG_DRM_PANEL_MOT_VDO_CSOT_VTDR6126A_1080_2352_DPHY_120HZ=m
CONFIG_DRM_PANEL_MOT_VDO_BOE_ILI77600A_1080_2400_DPHY_120HZ=m
CONFIG_DRM_PANEL_MOT_VDO_CSOT_TD4376B_1080_2400_DPHY_120HZ=m
CONFIG_DRM_PANEL_MOT_VDO_TXD_ILI77600A_1080_2400_DPHY_120HZ=m
CONFIG_DRM_PANEL_MOT_DUMMY_VDO_60HZ=m
CONFIG_DRM_PANEL_NUM_NO_LIMIT=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_DISP_ESD_NOTIFY_SUPPORT=y
CONFIG_CHARGER_SC89890H=m
CONFIG_CHARGER_SGM41542=m
CONFIG_MMI_SGM41542S_CHARGER=m
CONFIG_CHARGER_PUMP_NU2115A=m
CONFIG_TCPC_AW35615FCR=m
CONFIG_TCPC_CPS8851=m
CONFIG_TCPC_UPM7610=m
# CONFIG_WT6670F_QC3P is not set
# CONFIG_MOTO_DISCRETE_CHARGE_PUMP_SUPPORT is not set
# CONFIG_MOTO_CHG_WT6670F_SUPPORT is not set
CONFIG_WT6670F_I2C_400K=y
CONFIG_MOTO_WT6670F_SHUTDOWN_ONLY_DO_SW_RESET=y
# CONFIG_TCPC_MT6375 is not set
#disable MTK default touch drives
CONFIG_TOUCHSCREEN_MTK_TOUCH=""

CONFIG_CUSTOM_KERNEL_IMGSENSOR="mot_naples_s5khm9_mipi_raw mot_naples_imx882_mipi_raw mot_naples_s5kkds_mipi_raw mot_naples_gc32e1_mipi_raw mot_naples_ov08f_mipi_raw mot_naples_gc08a3_mipi_raw"
# CONFIG_MTK_ULTRASND_PROXIMITY is not set

CONFIG_MOTO_CHG_TCMD_SUPPORT=m
CONFIG_SND_SOC_FS181X=m
CONFIG_SND_SOC_SYDNEY_SYDNYL_MULTI_AUDIO_PA=y
CONFIG_SND_SOC_AW87XXX=m
CONFIG_SND_SOC_SIPA=m
CONFIG_FSA4480_I2C=m
CONFIG_SND_SOC_MOTO_MIC_BIAS=y
CONFIG_I2C_CHARDEV=y

# Motorola V2 File Based Encryption Driver Support.
CONFIG_FSCRYPT_WRAPED_KEY_MODE_SUPPORT=y

# Add charger pe5 customization
CONFIG_MOTO_PE50_CV_LOWER_BOUND_GAP_OFF=y
CONFIG_MOTO_PE50_IBUSOCP_RATIO_UPDATE=y

# Add swtp customization
CONFIG_MOTO_SWTP_CUST=y

#Moto sydney Camera
# CONFIG_MOT_NAPLES_CAMERA_PROJECT is not set
CONFIG_MOT_NAPLES_CAMERA_PROJECT=n
CONFIG_MOTO_DIO8015=m
CONFIG_MOTO_DIO80151C=m
CONFIG_MTK_FLASHLIGHT_NAPLES=n
CONFIG_MTK_FLASHLIGHT_PT=n
CONFIG_MTK_FLASHLIGHT_PT_STRICT=n
CONFIG_MTK_FLASHLIGHT_DLPT=n
CONFIG_MTK_VIDEO_LM3643=n
CONFIG_MTK_VIDEO_LM3644=n
CONFIG_SCHED_MOTO_UNFAIR=y
CONFIG_MOTO_SGM41606S_ENABLE_OTG=y
CONFIG_MOTO_SGM41606S_ENABLE_ERRLO=y
CONFIG_AW96XX_POWER_SUPPLY_ONLINE=y
CONFIG_AW96XX_MTK_KERNEL5XX_CHARGER_TYPE=y
CONFIG_SX937X_USB_CAL=y
CONFIG_SX937X_POWER_SUPPLY_ONLINE=y
CONFIG_SX937X_MTK_KERNEL5XX_CHARGER_TYPE=y
